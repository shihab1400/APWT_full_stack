# Copy to apps/api/.env and fill in.
PORT=4000
NODE_ENV=development

# Local PostgreSQL (no Docker)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mindease?schema=public"

# Access-token signing secret: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Frontend origin (CORS + links in emails)
WEB_ORIGIN=http://localhost:3000

# Seeded admin account (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@mindease.local
SEED_ADMIN_PASSWORD=Admin12345

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary model is busy or rate limited (free tier: 5 requests/min per model)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
